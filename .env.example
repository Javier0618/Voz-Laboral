# Copia este archivo como .env.local y reemplaza los valores FICTICIOS.
# Solo variables públicas: la clave "anon"/"publishable" de Supabase está pensada
# para el navegador y su seguridad depende de las políticas RLS.
# NUNCA pongas aquí la clave service_role ni contraseñas de la base de datos.
VITE_SUPABASE_URL=https://izzpirqqqwdvwbndnuql.supabase.co/
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Iml6enBpcnFxcXdkdndibmRudXFsIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTMwMTcxODQsImV4cCI6MjEwODU5MzE4NH0.ULCY0ARcwLtYhtHHEoLYDabGz1oOFzJJtX_A0Cv4ZGk
# Correo de contacto público que aparece en el pie de página (ficticio).
VITE_CONTACT_EMAIL=contacto.vozlaboral@gmail.com
# Google Analytics 4 (opcional). Identificador de medición «G-…». Si falta, no se
# carga Google ni aparece el aviso de cookies.
# VITE_GA_ID=G-XXXXXXXXXX
# Google AdSense (opcional, para más adelante). Identificador «ca-pub-…».
# VITE_ADSENSE_CLIENT=ca-pub-0000000000000000
# Verificación anti-robots Cloudflare Turnstile (opcional). Clave PÚBLICA del
# sitio «0x4…». La clave secreta NUNCA va aquí: va en Supabase (ver
# docs/despliegue-vps.md, «Protección contra bots»).
# VITE_TURNSTILE_SITE_KEY=0x4AAAAAAA0000000000000
# Entrar con Google (opcional). ID de cliente PÚBLICO de Google Cloud, termina en
# «.apps.googleusercontent.com». Con él, la web muestra el botón oficial de Google y
# la ventana de Google dice «tuvozlaboral.com» en vez de la dirección de Supabase.
# El secreto del cliente NUNCA va aquí: va solo en Supabase (docs/acceso-con-google.md).
# VITE_GOOGLE_CLIENT_ID=000000000000-xxxxxxxx.apps.googleusercontent.com
