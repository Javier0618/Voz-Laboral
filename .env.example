# VALORES FICTICIOS DE EJEMPLO: reemplázalos por los de tu proyecto de Supabase.
# Copia este archivo a .env.local. Nunca pongas aquí la clave service_role:
# el frontend solo usa la URL del proyecto y la clave pública (anon).
VITE_SUPABASE_URL=https://ejemplo-ficticio.supabase.co
VITE_SUPABASE_ANON_KEY=clave-anon-ficticia-no-valida
