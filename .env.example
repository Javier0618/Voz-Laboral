# Copia este archivo como .env.local y reemplaza los valores FICTICIOS.
# Solo variables públicas: la clave "anon"/"publishable" de Supabase está pensada
# para el navegador y su seguridad depende de las políticas RLS.
# NUNCA pongas aquí la clave service_role ni contraseñas de la base de datos.
VITE_SUPABASE_URL=https://TU-PROYECTO-FICTICIO.supabase.co
VITE_SUPABASE_ANON_KEY=clave-anon-ficticia-reemplazar
# Correo de contacto público que aparece en el pie de página (ficticio).
VITE_CONTACT_EMAIL=contacto@dominio-ficticio.test
